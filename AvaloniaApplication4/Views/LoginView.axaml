<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaloniaApplication4.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaApplication4.Views.LoginView"
             x:DataType="vm:LoginViewModel">
             

      <!-- StackPanel apila los elementos de arriba hacia abajo (por defecto).
         Margin="40" deja un margen alrededor de todo el contenido.
         VerticalAlignment="Center" centra todo verticalmente en la ventana.
         Spacing="15" pone 15px de separación entre cada elemento hijo. -->
    <StackPanel Margin="40" VerticalAlignment="Center" Spacing="15">

        <!-- TextBlock = texto fijo, no editable (como un <label>).
             Es el título de la pantalla. -->
        <TextBlock Text="Iniciar sesión"
                   FontSize="24"
                   HorizontalAlignment="Center" />

        <!-- Otro TextBlock, ahora como etiqueta del campo de abajo -->
        <!--TextBlock Text="Usuario" /-->

        <!-- TextBox = campo de texto editable.
             Text="{Binding Usuario}" es el BINDING:
             conecta este campo con la propiedad "Usuario" del LoginViewModel.
             Cuando el usuario escribe acá, el valor se guarda solo en esa propiedad.
             Watermark = texto gris de ayuda que se ve cuando el campo está vacío. -->
        <TextBlock Text="Usuario" />
        <TextBox Text="{Binding Usuario}" PlaceholderText="Ingresá tu usuario" />

        <!-- Etiqueta para el campo de contraseña -->
        <TextBlock Text="Contraseña" />

        <!-- Mismo concepto que el TextBox de arriba, pero conectado
             a la propiedad "Contrasena" del ViewModel.
             PasswordChar="*" hace que se muestren asteriscos
             en vez del texto real que escribe el usuario. -->
        

        <TextBox Text="{Binding Contrasena}" PlaceholderText="Ingresá tu contraseña"
          PasswordChar="*" />

        <!-- Button = el botón de acción.
             Por ahora no hace nada al hacer click (eso lo conectamos después,
             con un [RelayCommand] en el ViewModel).
             Content = el texto que se muestra dentro del botón. -->
		<TextBlock Text="{Binding MensajeError}" Foreground="Red" HorizontalAlignment="Center" />
		<TextBlock Text="{Binding MensajeExito}" Foreground="Green" HorizontalAlignment="Center" />

		<Button Content="Ingresar"
				Command="{Binding IngresarCommand}"
                HorizontalAlignment="Center"
                Margin="0,10,0,0" />

    </StackPanel>
</UserControl>
