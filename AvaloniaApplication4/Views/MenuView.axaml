<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaloniaApplication4.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaApplication4.Views.MenuView"
             x:DataType="vm:MenuViewModel">

	<ScrollViewer>
		<StackPanel Margin="40" Spacing="15">

			<TextBlock Text="Menú de Viandas de la Semana"
                       FontSize="22"
                       HorizontalAlignment="Center" />

			<TextBlock Text="Cargando..." IsVisible="{Binding Cargando}" HorizontalAlignment="Center" />
			<TextBlock Text="{Binding MensajeError}" Foreground="Red" HorizontalAlignment="Center" />
			<TextBlock Text="{Binding MensajeExito}" Foreground="Green" HorizontalAlignment="Center" />

			<ItemsControl ItemsSource="{Binding Viandas}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<CheckBox Content="{Binding Nombre}"
                                  IsChecked="{Binding Activa}"
                                  Margin="0,5" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<!-- Formulario de alta -->
			<Border BorderBrush="Gray" BorderThickness="1" Padding="15" CornerRadius="4">
				<StackPanel Spacing="10">
					<TextBlock Text="Agregar una vianda" FontSize="18" FontWeight="Bold" />

					<TextBox Text="{Binding NuevoNombre}" PlaceholderText="Nombre" />
					<TextBox Text="{Binding NuevaDescripcion}" PlaceholderText="Descripción" />
					<TextBox Text="{Binding NuevoPrecio}" PlaceholderText="Precio (ej: 5500)" />

					<ComboBox ItemsSource="{Binding Categorias}"
                              SelectedItem="{Binding CategoriaSeleccionada}"
                              PlaceholderText="Elegí una categoría"
                              HorizontalAlignment="Stretch" />

					<Button Content="Agregar vianda"
                            Command="{Binding AgregarViandaCommand}"
                            HorizontalAlignment="Center" />
				</StackPanel>
			</Border>

			<Button Content="Volver a Inicio"
                    Command="{Binding VolverAInicioCommand}"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0" />
		</StackPanel>
	</ScrollViewer>

</UserControl>